# Copy to .env.local. Never commit secrets or share them in chat.
# App origin: use the actual local port, then the deployed HTTPS origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key

# Keep the site out of search engines until launch requirements pass.
LAUNCH_READY=false

# Sender must be verified in Resend; sending stays disabled by default.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_ENABLED=false
EMAIL_PROVIDER_TESTED=false

# Generate distinct random secrets. Minimum lengths: 24 / 32 / 32 chars.
CRON_SECRET=
NEWSLETTER_TOKEN_SECRET=
NOTIFICATION_LINK_SECRET=

# Public product image uploads: keep supabase until R2 credentials are ready.
IMAGE_STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public HTTPS bucket address, e.g. https://pub-example.r2.dev (not the S3 API endpoint).
R2_PUBLIC_BASE_URL=

# Optional WhatsApp Business Platform. Keep sending disabled until a controlled provider test passes.
# Private values: never prefix these fields with NEXT_PUBLIC_.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER_TESTED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Copy a currently supported Graph API version from your Meta app, e.g. vXX.X.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Exact Meta-approved template names. Update body variables: name, message.
WHATSAPP_UPDATE_TEMPLATE=
# Renewal body variables: name, package name, expiry date.
WHATSAPP_RENEWAL_TEMPLATE=
