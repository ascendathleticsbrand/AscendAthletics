{
  "name": "ascend-athletics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node supabase/tests/run-pglite.mjs",
    "test:smoke": "node tests/http-smoke.mjs",
    "check:r2": "node scripts/check-r2.mjs",
    "admin:password": "node scripts/reset-admin-password.mjs",
    "format": "prettier --write src scripts tests \"*.{ts,mts,mjs,json}\" docs/CODE_GUIDE.md --ignore-unknown",
    "format:check": "prettier --check src scripts tests \"*.{ts,mts,mjs,json}\" docs/CODE_GUIDE.md --ignore-unknown"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "1.56.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
